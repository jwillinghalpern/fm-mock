{
  "name": "fm-mock",
  "version": "1.5.0",
  "description": "A framework for mocking the FileMaker webviewer window object for developing and testing fm webviewer apps in browser.",
  "homepage": "https://github.com/jwillinghalpern/fm-mock#readme",
  "issues": "https://github.com/jwillinghalpern/fm-mock/issues",
  "main": "dist/fm-mock.js",
  "module": "dist/fm-mock.mjs",
  "types": "dist/fm-mock.d.ts",
  "exports": {
    ".": {
      "types": "./dist/fm-mock.d.ts",
      "import": "./dist/fm-mock.mjs",
      "require": "./dist/fm-mock.js",
      "default": "./dist/fm-mock.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "filemaker",
    "javascript",
    "web viewer",
    "webviewer",
    "mock",
    "stub",
    "browser"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
		"prepare": "npm run build"
  },
  "author": "Josh Willing Halpern<josh@willingapps.com>",
  "license": "ISC",
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@vitest/coverage-v8": "^4.1.10",
    "fm-gofer": "^1.11.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
